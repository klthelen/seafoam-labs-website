---
import config from "virtual:starlight/user-config";
import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import Search from "virtual:starlight/components/Search";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ProjectsMenu from "../navigation/ProjectsMenu.astro";
import SiteMenu from "../navigation/SiteMenu.astro";
import { sitePages } from "../../data/navigation";

const shouldRenderSearch =
  config.pagefind ||
  config.components.Search !== "@astrojs/starlight/components/Search.astro";
const { hasSidebar, siteTitleHref } = Astro.locals.starlightRoute;
const isHomepage = Astro.url.pathname === "/";
const currentPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
---

<div class="header-content" data-docs={hasSidebar ? "" : undefined}>
  <nav
    class="site-header"
    data-navigation-header
    data-homepage={isHomepage ? "" : undefined}
    aria-label="Primary"
  >
    <SiteTitle />
    <a
      class="home-link sf-nav-link"
      href={siteTitleHref}
      aria-current={siteTitleHref === currentPath ? "page" : undefined}
      data-desktop-navigation
    >
      Home
    </a>
    <ProjectsMenu />
    <div class="page-links" data-desktop-navigation>
      {sitePages.map(({ href, label }) => (
        <a
          class="sf-nav-link"
          {href}
          aria-current={href === currentPath ? "page" : undefined}
        >
          {label}
        </a>
      ))}
    </div>
    {shouldRenderSearch && (
      <div class="header-search">
        <Search />
      </div>
    )}
    <div class="header-socials" data-desktop-navigation>
      <SocialIcons />
    </div>
    <div class="site-menu">
      <SiteMenu />
    </div>
    {config.isMultilingual && <LanguageSelect />}
  </nav>
</div>

<script>
  for (const header of document.querySelectorAll<HTMLElement>(".site-header")) {
    const frame = header.closest<HTMLElement>(".page > .header");
    const siteMenu = header.querySelector<HTMLElement>(".site-menu");
    const siteDisclosure = siteMenu?.querySelector("details");
    const siteTrigger = siteDisclosure?.querySelector("summary");
    const logoLink = header.querySelector<HTMLAnchorElement>(".site-title");
    if (!frame || !siteMenu || !siteDisclosure || !siteTrigger || !logoLink)
      continue;

    const disclosures = header.querySelectorAll<HTMLDetailsElement>(
      ".navigation-disclosure",
    );
    const desktopGroups = header.querySelectorAll<HTMLElement>(
      "[data-desktop-navigation]",
    );
    const search = header.querySelector("site-search");
    const sidebar = document.getElementById("starlight__sidebar");
    const sidebarClose =
      sidebar?.querySelector<HTMLButtonElement>(".sidebar-close");
    const docsButton =
      document.querySelector<HTMLButtonElement>(".docs-menu-toggle");

    const closeDisclosures = (except?: HTMLDetailsElement) => {
      for (const disclosure of disclosures) {
        if (disclosure !== except) disclosure.open = false;
      }
    };

    header.addEventListener("navigation-disclosure-toggle", (event) => {
      const disclosure = event.target;
      if (!(disclosure instanceof HTMLDetailsElement) || !disclosure.open)
        return;
      closeDisclosures(disclosure);
      search?.dispatchEvent(new Event("site-search-dismiss"));
      if (sidebar?.matches(":popover-open")) sidebar.hidePopover();
    });

    header.addEventListener("site-search-open", () => {
      header.setAttribute("data-search-open", "");
      closeDisclosures();
      if (sidebar?.matches(":popover-open")) sidebar.hidePopover();
    });

    header.addEventListener("site-search-close", () => {
      header.removeAttribute("data-search-open");
    });

    sidebar?.addEventListener("beforetoggle", (event) => {
      if (event.newState !== "open") return;
      search?.dispatchEvent(new Event("site-search-dismiss"));
      if (
        [...disclosures].some((disclosure) =>
          disclosure.contains(document.activeElement),
        )
      )
        docsButton?.focus();
      closeDisclosures();
    });

    const focusDesktopCounterpart = (focused: Element | null) => {
      const destination = focused?.closest("a")?.href;
      const counterpart = [
        ...header.querySelectorAll<HTMLAnchorElement>(
          "a[data-desktop-navigation], [data-desktop-navigation] a",
        ),
      ].find((link) => link.href === destination);
      (counterpart ?? logoLink).focus();
    };

    // CSS can hide a focused control before ResizeObserver runs.
    document.addEventListener("focusout", (event) => {
      if (header.hasAttribute("data-search-open")) return;
      const focused = event.target;
      if (!(focused instanceof HTMLElement) || focused.checkVisibility())
        return;

      if (siteMenu.contains(focused) && !siteMenu.checkVisibility()) {
        focusDesktopCounterpart(focused);
      } else if ([...desktopGroups].some((group) => group.contains(focused))) {
        siteTrigger.focus();
      } else if (focused === docsButton || focused === sidebarClose) {
        const sidebarLink =
          sidebar?.querySelector<HTMLAnchorElement>('a[aria-current="page"]') ??
          sidebar?.querySelector("a");
        sidebarLink?.focus();
      } else if (sidebar?.contains(focused) && !sidebar.checkVisibility()) {
        docsButton?.focus();
      }
    });

    let desktop =
      getComputedStyle(header)
        .getPropertyValue("--sf-navigation-layout")
        .trim() === "desktop";
    const updateHeader = () => {
      const nextDesktop =
        getComputedStyle(header)
          .getPropertyValue("--sf-navigation-layout")
          .trim() === "desktop";
      if (desktop !== nextDesktop) {
        const focused = document.activeElement;
        if (nextDesktop) {
          const moveFocus = siteMenu.contains(focused);
          siteDisclosure.open = false;
          if (moveFocus) focusDesktopCounterpart(focused);
        } else if (
          [...desktopGroups].some((group) => group.contains(focused))
        ) {
          siteTrigger.focus();
        }
        desktop = nextDesktop;
      }
      if (!header.hasAttribute("data-homepage")) {
        if (docsButton?.checkVisibility()) {
          document.documentElement.style.setProperty(
            "--sf-docs-control-height",
            docsButton.getBoundingClientRect().height + "px",
          );
        }
        document.documentElement.style.setProperty(
          "--sl-nav-height",
          frame.getBoundingClientRect().height + "px",
        );
      }
    };

    // Apply measured spacing after resize delivery; it can change the frame's size.
    const headerResize = new ResizeObserver(() => {
      requestAnimationFrame(updateHeader);
    });
    headerResize.observe(frame, { box: "border-box" });
    if (docsButton) headerResize.observe(docsButton, { box: "border-box" });
    updateHeader();
  }
</script>

<style>
  .header-content {
    padding: calc(16px + env(safe-area-inset-top))
      max(16px, env(safe-area-inset-right)) 16px
      max(16px, env(safe-area-inset-left));
  }

  .site-header {
    --sf-navigation-layout: compact;
    --sf-navigation-gutter: 16px;

    box-sizing: border-box;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    max-inline-size: 77.5rem;
    min-block-size: 4rem;
    margin-inline: auto;
    padding: 8px;
    border-radius: 999px;
    background: var(--sf-surface);
    color: var(--sf-text);
  }

  .site-header :global(.site-title) {
    box-sizing: border-box;
    flex: none;
    justify-content: center;
    min-inline-size: 44px;
    min-block-size: 44px;
    padding: 4px;
    border-radius: 999px;
  }

  .site-header :global(.site-title img) {
    inline-size: 32px;
    block-size: 32px;
  }

  .site-header :global(.site-title:focus-visible) {
    outline: 2px solid var(--sf-focus);
    outline-offset: 3px;
  }

  .site-header :global(.disclosure-trigger) {
    gap: 8px;
    min-inline-size: 44px;
    min-block-size: 44px;
    padding: 0.5rem;
  }

  .home-link,
  .page-links,
  .header-socials {
    display: none;
    align-items: center;
  }

  .page-links {
    gap: inherit;
  }

  .home-link,
  .page-links a {
    padding-inline: 1rem;
    font-weight: 600;
  }

  .home-link:hover,
  .page-links a:hover,
  .home-link[aria-current="page"],
  .page-links a[aria-current="page"] {
    text-decoration: none;
  }

  @media (hover: hover) {
    .home-link:hover,
    .page-links a:hover {
      color: var(--sf-nav-link-hover);
    }
  }

  .header-search {
    margin-inline-start: auto;
  }

  .site-header[data-search-open] .header-search {
    flex: 1;
    min-inline-size: 0;
  }

  .header-socials {
    gap: 1rem;
  }

  .header-socials::before {
    content: "";
    inline-size: 1px;
    block-size: 1.5rem;
    background: var(--sf-boundary);
  }

  .site-menu {
    min-inline-size: 0;
  }

  .site-menu :global(svg) {
    inline-size: 20px;
    block-size: 20px;
  }

  @media (width < 50rem) {
    .header-content[data-docs] {
      padding-block-end: calc(var(--sf-docs-control-height, 44px) + 24px);
    }
  }

  @container site-navigation (min-width: 24rem) {
    .site-header {
      padding-inline: 12px;
    }
  }

  @container site-navigation (min-width: 64rem) {
    .header-content {
      padding: calc(24px + env(safe-area-inset-top))
        max(24px, env(safe-area-inset-right)) 24px
        max(24px, env(safe-area-inset-left));
    }

    .site-header {
      --sf-navigation-layout: desktop;
      --sf-navigation-gutter: 24px;

      gap: 1rem;
      min-block-size: 6rem;
      padding-inline: 2rem;
    }

    .site-header :global(.site-title img) {
      inline-size: 2.5rem;
      block-size: 2.5rem;
    }

    .home-link,
    .page-links,
    .header-socials {
      display: flex;
    }

    .home-link,
    .page-links a {
      min-block-size: 3rem;
      font-size: 1.25rem;
    }

    .header-search :global(.sf-icon-control),
    .header-socials :global(.social-link) {
      min-inline-size: 3rem;
      min-block-size: 3rem;
    }

    .header-search :global(.sf-icon-control svg),
    .header-socials :global(svg) {
      inline-size: 1.5rem;
      block-size: 1.5rem;
    }

    .header-search :global(#starlight__search input) {
      font-size: 1.25rem;
    }

    .site-menu {
      display: none;
    }
  }

  .site-header[data-search-open] > :global(.navigation-disclosure),
  .site-header[data-search-open] .home-link,
  .site-header[data-search-open] .page-links,
  .site-header[data-search-open] .site-menu {
    display: none;
  }

  :global(:root) {
    --sl-nav-height: calc(6rem + env(safe-area-inset-top));
  }

  :global(.page > .header) {
    container: site-navigation / inline-size;
    height: auto;
    padding: 0;
    border: 0;
    background: var(--sf-canvas);
  }

  :global(.page > .header:has(.site-header[data-homepage])) {
    position: static;
    background: transparent;
  }

  :global(.page:has(.site-header[data-homepage]) > .main-frame) {
    padding-top: 0;
  }

  @media (width < 50rem) {
    :global(:root[data-has-sidebar]) {
      --sl-nav-height: calc(9.25rem + env(safe-area-inset-top));
    }
  }

  @media (min-width: 64rem) {
    :global(:root) {
      --sl-nav-height: calc(9rem + env(safe-area-inset-top));
    }
  }

  @media (scripting: none) {
    :global(.page > .header) {
      position: static;
    }

    :global(.main-frame) {
      padding-top: var(--sl-mobile-toc-height);
    }

    .header-content[data-docs] {
      padding-block-end: 0;
    }
  }

  @media (max-height: 32rem) {
    :global(.page > .header) {
      position: static;
    }

    :global(.page > .main-frame) {
      padding-top: 0;
    }

    :global(:root[data-has-sidebar]) {
      scroll-padding-top: 1.5rem;
    }

    :global(mobile-starlight-toc nav) {
      position: static;
    }

    :global(mobile-starlight-toc .dropdown) {
      max-height: none;
    }

    :global(.page > .sidebar .sidebar-pane) {
      inset-block: 0;
      scroll-padding-block: 50px 8px;
    }

    :global(.right-sidebar) {
      position: sticky;
      top: 0;
      height: auto;
      max-height: 100svh;
      padding-top: 0;
    }

    @media (min-width: 50rem) {
      :global(.page:has(.header-content[data-docs])) {
        display: grid;
        grid-template-columns: var(--sl-sidebar-width) minmax(0, 1fr);
        grid-template-rows: auto 1fr;
      }

      :global(.page > .header) {
        grid-column: 1 / -1;
      }

      :global(.page > .sidebar) {
        grid-column: 1;
        grid-row: 2;
        min-width: 0;
      }

      :global(.page > .sidebar .sidebar-pane) {
        position: sticky;
        top: 0;
        max-height: 100svh;
        width: 100%;
      }

      :global(.page:has(.header-content[data-docs]) > .main-frame) {
        grid-column: 2;
        grid-row: 2;
        padding-inline-start: 0;
      }
    }
  }
</style>
