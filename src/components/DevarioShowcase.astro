---
import { Icon } from "@astrojs/starlight/components";
import { getImage } from "astro:assets";
import CopyChecksum from "./CopyChecksum.astro";
import { isoDownloadUrl, isoSha256 } from "../consts";
import logo from "../assets/images/devario-logo.png";
import ditherMask from "../assets/images/devario-dither-mask.png";
import buttonWave from "../assets/images/button-wave.svg?url";

// The fish ends above row 640; the embedded DEVARIO wordmark starts below it.
const logoMarkHeight = 640;
const dither = await getImage({ src: ditherMask, format: "webp", quality: 90 });
---

<section
  class="devario-showcase not-content"
  aria-labelledby="devario-title"
  style={{ "--wave-mask": `url("${buttonWave}")` }}
>
  <div class="devario-content">
    <div class="devario-heading">
      <h2 id="devario-title">
        <span class="devario-title-base">DEVARIO</span>
        <span class="devario-title-wave" aria-hidden="true">
          DEVARIO
        </span>
      </h2>
      <a class="sf-link devario-overview" href="/devario/overview/">
        Overview
        <Icon name="right-arrow" size="1.25rem" />
      </a>
    </div>
    <p class="devario-description">
      Linux desktop built around Aqueous, Pearl, and Shelly. Install with
      Calamares and make it your own.
    </p>
    <div class="devario-downloads">
      <a class="sf-action sf-action--secondary" href={isoDownloadUrl}>
        <Icon name="download" />
        Download ISO
      </a>
      <CopyChecksum checksum={isoSha256} />
    </div>
  </div>
  <span
    class="devario-logo"
    aria-hidden="true"
    style={{
      "--devario-logo": `url(${logo.src})`,
      "--devario-dither": `url(${dither.src})`,
      aspectRatio: `${logo.width} / ${logoMarkHeight}`,
    }}
  ></span>
  <a
    class="sf-link devario-github"
    href="https://github.com/Seafoam-Labs/devario-os"
  >
    View on GitHub
    <Icon name="external" size="1.25rem" />
  </a>
</section>

<style>
  @font-face {
    font-family: "Poppins";
    src: url("../assets/fonts/poppins-700.woff2") format("woff2");
    font-style: normal;
    font-weight: 700;
    font-display: swap;
  }

  .devario-showcase {
    --devario-gradient: linear-gradient(90deg in srgb, #5ec4b0, #0a9cf4);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    min-width: 0;
    padding: 1.5rem;
    border-radius: 1.5rem;
    background: var(--sf-surface);
    color: var(--sf-text);
  }
  .devario-content {
    display: grid;
    align-content: start;
    gap: 1.5rem;
    min-width: 0;
  }
  .devario-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
  }
  h2 {
    position: relative;
    margin: 0;
    font-family: "Poppins", var(--sl-font-system);
    font-size: 2.125rem;
    font-weight: 700;
    letter-spacing: 0.23em;
    line-height: 1.235;
    overflow-wrap: anywhere;
  }
  .devario-title-wave {
    display: none;
  }

  @supports (background-clip: text) and (mask-composite: exclude) {
    @media (hover: hover) and (pointer: fine) and (forced-colors: none) {
      .devario-title-base {
        display: block;
        /* Remove the solid glyphs wherever the gradient wave replaces them. */
        mask-image: linear-gradient(#000 0 0), var(--wave-mask);
        mask-mode: alpha;
        mask-size:
          100% 100%,
          200% 240%;
        mask-repeat: no-repeat;
        mask-position:
          0% 0%,
          0% 0%;
        mask-composite: exclude;
      }
      .devario-title-wave,
      .devario-logo::after {
        position: absolute;
        inset: 0;
        display: block;
        background: var(--devario-gradient);
        pointer-events: none;
        mask-image: var(--wave-mask);
        mask-mode: alpha;
        mask-size: 200% 240%;
        mask-repeat: no-repeat;
        mask-position: 0% 0%;
      }
      .devario-title-wave {
        background-clip: text;
        color: transparent;
        user-select: none;
      }
      .devario-logo::after {
        content: "";
      }
      .devario-showcase:is(:hover, :focus-within) .devario-title-base {
        mask-position:
          0% 0%,
          50% 100%;
      }
      .devario-showcase:is(:hover, :focus-within) .devario-title-wave,
      .devario-showcase:is(:hover, :focus-within) .devario-logo::after {
        mask-position: 50% 100%;
      }
      @media (prefers-reduced-motion: no-preference) {
        .devario-title-base,
        .devario-title-wave,
        .devario-logo::after {
          transition: mask-position 360ms ease-out;
        }
      }
    }
  }

  .devario-logo {
    position: relative;
    display: block;
    justify-self: center;
    width: min(100%, 18rem);
    background-color: light-dark(#000, #fff);
    mask:
      var(--devario-logo) top / 100% auto no-repeat,
      var(--devario-dither) center / 100% 100% no-repeat;
    mask-mode: alpha, luminance;
    mask-composite: intersect;
    pointer-events: none;
  }
  .devario-description {
    min-width: 0;
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    text-align: start;
    color: var(--sf-text-muted);
    overflow-wrap: anywhere;
  }
  .devario-downloads {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    min-width: 0;
    gap: 0.75rem 1.5rem;
  }
  .devario-overview,
  .devario-github {
    display: inline-flex;
    justify-self: start;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    max-width: 100%;
    font-size: 1rem;
    line-height: 1.5;
  }
  .devario-overview {
    gap: 0.125rem;
  }
  .devario-overview :global(svg),
  .devario-github :global(svg) {
    flex: none;
  }

  @media (width < 24rem) {
    .devario-showcase {
      padding: 1.25rem;
    }
  }

  @media (min-width: 64rem) {
    .devario-showcase {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      column-gap: 3rem;
      padding: 2rem 2.5rem;
    }
    .devario-content {
      grid-column: 1;
      grid-row: 1;
      padding-top: 0.5rem;
    }
    h2 {
      font-size: 3rem;
      line-height: 1.167;
    }
    .devario-logo {
      grid-column: 2;
      grid-row: 1;
      align-self: center;
      width: min(100%, 31rem);
    }
    .devario-description {
      max-width: 45ch;
      font-size: 1.125rem;
      line-height: 1.556;
    }
    .devario-github {
      grid-column: 2;
      grid-row: 1;
      align-self: start;
      align-items: flex-start;
      justify-self: end;
    }
  }
</style>
