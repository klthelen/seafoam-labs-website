---
import { Icon } from "@astrojs/starlight/components";
import CopyChecksum from "./CopyChecksum.astro";
import { isoChecksumUrl, isoDownloadUrl, isoSha256 } from "../consts";
import fish from "../assets/images/fish-dithered-stronger-transparent.png";
---

<section class="devario-showcase not-content" aria-labelledby="devario-title">
  <h2 id="devario-title">Devario</h2>
  <span
    class="devario-fish"
    aria-hidden="true"
    style={{
      "--fish-artwork": `url(${fish.src})`,
      aspectRatio: `${fish.width} / ${fish.height}`,
    }}
  ></span>
  <p class="devario-description">
    Linux desktop built around Aqueous, Pearl, and Shelly. Install with
    Calamares and make it your own.
  </p>
  <a
    class="sf-action sf-action--primary devario-overview"
    href="/devario/overview/"
  >
    Overview
  </a>
  <div class="devario-downloads">
    <a class="sf-action sf-action--secondary" href={isoDownloadUrl}>
      <Icon name="download" />
      Download ISO
    </a>
    <CopyChecksum checksum={isoSha256} href={isoChecksumUrl} />
  </div>
  <a
    class="sf-link devario-github"
    href="https://github.com/Seafoam-Labs/devario-os"
  >
    View on GitHub
    <Icon name="external" size="1.25rem" />
  </a>
</section>

<style>
  .devario-showcase {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    min-width: 0;
    padding: 24px;
    border-radius: 24px;
    background: var(--sf-surface);
    color: var(--sf-text);
  }
  h2 {
    margin: 0;
    font-size: 2.125rem;
    line-height: 1.235;
    text-align: center;
    overflow-wrap: anywhere;
  }
  .devario-fish {
    display: block;
    justify-self: center;
    width: min(100%, 9.0625rem);
    background-color: currentColor;
    mask: var(--fish-artwork) center / contain no-repeat;
    mask-mode: alpha;
  }
  .devario-description {
    min-width: 0;
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--sf-text-muted);
    overflow-wrap: anywhere;
  }
  .devario-downloads {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: 0.75rem;
    margin-top: -0.75rem;
  }
  .devario-github {
    display: inline-flex;
    justify-self: center;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    max-width: 100%;
    font-size: 1rem;
    line-height: 1.5;
  }
  .devario-github :global(svg) {
    flex: none;
  }

  @media (width < 24rem) {
    .devario-showcase {
      padding: 20px;
    }
  }

  @media (min-width: 64rem) {
    .devario-showcase {
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
      column-gap: 3rem;
      padding: 40px;
    }
    h2 {
      grid-column: 1;
      text-align: start;
      font-size: 3rem;
      line-height: 1.167;
    }
    .devario-fish {
      grid-column: 2;
      grid-row: 1 / 4;
      align-self: center;
      width: 100%;
    }
    .devario-description {
      grid-column: 1;
      max-width: 45ch;
      font-size: 1.125rem;
      line-height: 1.556;
    }
    .devario-overview {
      grid-column: 1;
      justify-self: start;
    }
    .devario-downloads {
      grid-column: 1 / -1;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 1.5rem;
      margin-top: 0.5rem;
    }
    .devario-github {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }
</style>
