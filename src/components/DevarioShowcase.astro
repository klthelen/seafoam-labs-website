---
import { Icon } from "@astrojs/starlight/components";
import CopyChecksum from "./CopyChecksum.astro";
import { isoDownloadUrl, isoSha256 } from "../consts";
import fish from "../assets/images/fish-dithered-stronger-transparent.png";
---

<section class="devario-showcase not-content" aria-labelledby="devario-title">
  <div class="devario-content">
    <div class="devario-heading">
      <h2 id="devario-title">Devario</h2>
      <a class="sf-link devario-overview" href="/devario/overview/">
        Overview
        <Icon name="right-arrow" size="1.25rem" />
      </a>
    </div>
    <p class="devario-description">
      Linux desktop built around Aqueous, Pearl, and Shelly. Install with
      Calamares and make it your own.
    </p>
    <div class="devario-downloads">
      <a class="sf-action sf-action--secondary" href={isoDownloadUrl}>
        <Icon name="download" />
        Download ISO
      </a>
      <CopyChecksum checksum={isoSha256} />
    </div>
  </div>
  <span
    class="devario-fish"
    aria-hidden="true"
    style={{
      "--fish-artwork": `url(${fish.src})`,
      aspectRatio: `${fish.width} / ${fish.height}`,
    }}
  ></span>
  <a
    class="sf-link devario-github"
    href="https://github.com/Seafoam-Labs/devario-os"
  >
    View on GitHub
    <Icon name="external" size="1.25rem" />
  </a>
</section>

<style>
  .devario-showcase {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    min-width: 0;
    padding: 1.5rem;
    border-radius: 1.5rem;
    background: var(--sf-surface);
    color: var(--sf-text);
  }
  .devario-content {
    display: grid;
    align-content: start;
    gap: 1.5rem;
    min-width: 0;
  }
  .devario-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
  }
  h2 {
    margin: 0;
    font-size: 2.125rem;
    line-height: 1.235;
    overflow-wrap: anywhere;
  }
  .devario-fish {
    display: block;
    justify-self: center;
    width: min(100%, 18rem);
    background-color: currentColor;
    mask: var(--fish-artwork) center / contain no-repeat;
    mask-mode: alpha;
    pointer-events: none;
  }
  .devario-description {
    min-width: 0;
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    text-align: start;
    color: var(--sf-text-muted);
    overflow-wrap: anywhere;
  }
  .devario-downloads {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    min-width: 0;
    gap: 0.75rem 1.5rem;
  }
  .devario-overview,
  .devario-github {
    display: inline-flex;
    justify-self: start;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    max-width: 100%;
    font-size: 1rem;
    line-height: 1.5;
  }
  .devario-overview {
    gap: 0.125rem;
  }
  .devario-overview :global(svg),
  .devario-github :global(svg) {
    flex: none;
  }

  @media (width < 24rem) {
    .devario-showcase {
      padding: 1.25rem;
    }
  }

  @media (min-width: 64rem) {
    .devario-showcase {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      column-gap: 3rem;
      padding: 2rem 2.5rem;
    }
    .devario-content {
      grid-column: 1;
      grid-row: 1;
      padding-top: 0.5rem;
    }
    h2 {
      font-size: 3rem;
      line-height: 1.167;
    }
    .devario-fish {
      grid-column: 2;
      grid-row: 1;
      align-self: center;
      width: min(100%, 31rem);
    }
    .devario-description {
      max-width: 45ch;
      font-size: 1.125rem;
      line-height: 1.556;
    }
    .devario-github {
      grid-column: 2;
      grid-row: 1;
      align-self: start;
      align-items: flex-start;
      justify-self: end;
    }
  }
</style>
